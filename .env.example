# Copy this file to .env and adjust as needed.
# `docker compose` reads .env automatically.

# Port exposed on the HOST machine, mapped to nginx's port 80 in the container.
# 8080 = safe for local testing when the host already runs nginx on :80.
# 80   = the real deployment target (host port 80 -> container port 80).
HOST_PORT=8080

# Backend API base URL baked into the Flutter web build at build time.
API_BASE_URL=http://localhost:8000/api/v1
